  <script>
    /* ---------- Tema ---------- */
    const root=document.documentElement, themeToggle=document.getElementById("themeToggle");
    function updateToggle(){ const d=root.dataset.theme==="dark"; themeToggle.textContent=d?"☀️ Modo estándar":"🌙 Modo oscuro"; themeToggle.setAttribute("aria-pressed",String(d)); }
    themeToggle.addEventListener("click",()=>{ root.dataset.theme=root.dataset.theme==="dark"?"light":"dark"; localStorage.setItem("londres-theme",root.dataset.theme); updateToggle(); });
    updateToggle();

    /* ---------- Menú ---------- */
    const menuBtn=document.getElementById("menuBtn"), menuPanel=document.getElementById("menuPanel");
    function closeMenu(){ menuPanel.classList.remove("open"); menuBtn.setAttribute("aria-expanded","false"); }
    menuBtn.addEventListener("click",(e)=>{ e.stopPropagation(); const open=menuPanel.classList.toggle("open"); menuBtn.setAttribute("aria-expanded",String(open)); });
    document.addEventListener("click",(e)=>{ if(!menuPanel.contains(e.target)&&e.target!==menuBtn) closeMenu(); });
    document.addEventListener("keydown",(e)=>{ if(e.key==="Escape"){ closeMenu(); document.querySelectorAll(".modal-overlay.open").forEach(m=>m.classList.remove("open")); } });

    /* ---------- Modales ---------- */
    function openModal(id){ document.getElementById(id).classList.add("open"); closeMenu(); }
    function closeModal(id){ document.getElementById(id).classList.remove("open"); }

    /* ---------- Volver al hotel ---------- */
    function goHotel(){
      const q="Eurotraveller+Hotel-Premier-Tower+Bridge+194-202+Old+Kent+Road+Southwark+Londres+SE1+5TY+Reino+Unido";
      window.open("https://www.google.com/maps/search/?api=1&query="+q,"_blank","noopener");
      closeMenu();
    }

    /* ---------- Calculadora (página nueva) ---------- */
    function openCalculator(){
      closeMenu();
      const w=window.open("","_blank","noopener");
      w.document.write(`<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Calculadora £ ↔ €</title>
      <style>body{font-family:'Segoe UI',sans-serif;background:#0f172a;color:#e5e7eb;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0}
      .card{background:#111827;border:1px solid #334155;border-radius:18px;padding:28px;width:min(420px,92vw);box-shadow:0 12px 40px rgba(0,0,0,.5)}
      h1{font-size:1.3rem;margin:0 0 6px;color:#7dd3fc;text-align:center}p.sub{margin:0 0 18px;color:#94a3b8;text-align:center;font-size:.9rem}
      label{display:block;font-size:.85rem;color:#94a3b8;margin:14px 0 4px}
      .row{display:flex;gap:8px;align-items:center}
      input,select{flex:1;background:#0f172a;border:1px solid #334155;color:#e5e7eb;border-radius:10px;padding:12px;font-size:1.05rem}
      input:focus,select:focus{outline:2px solid #38bdf8}
      .sym{font-weight:700;color:#7dd3fc;width:22px;text-align:center}
      .out{background:#0f172a;border:1px solid #334155;border-radius:10px;padding:12px;font-size:1.05rem;min-height:1.2em}
      .rate{margin-top:18px;font-size:.85rem;color:#94a3b8;text-align:center}
      .rate input{flex:0 0 90px;text-align:center;padding:6px}</style></head><body>
      <div class="card"><h1>🧮 Calculadora £ ↔ €</h1><p class="sub">Conversor Libras esterlinas / Euros</p>
      <label>Libras (GBP)</label><div class="row"><span class="sym">£</span><input id="gbp" type="number" min="0" step="0.01" value="100" oninput="calc('gbp')"></div>
      <label>Euros (EUR)</label><div class="row"><span class="sym">€</span><input id="eur" type="number" min="0" step="0.01" value="117" oninput="calc('eur')"></div>
      <div class="rate">1 £ = <input id="rate" type="number" min="0.01" step="0.0001" value="1.17" oninput="recalc()"> €</div>
      </div><script>
      const gbp=document.getElementById('gbp'),eur=document.getElementById('eur'),rate=document.getElementById('rate');
      function fmt(n){return (Math.round(n*100)/100).toString();}
      function calc(from){const r=parseFloat(rate.value)||0;if(from==='gbp'){eur.value=fmt((parseFloat(gbp.value)||0)*r);}else{gbp.value=fmt((parseFloat(eur.value)||0)/(r||1));}}
      function recalc(){const r=parseFloat(rate.value)||0;gbp.value=fmt((parseFloat(gbp.value)||0));eur.value=fmt((parseFloat(gbp.value)||0)*r);}
      <\/script></body></html>`);
      w.document.close();
    }

    /* ---------- Wiki: datos ---------- */
    const SITES=[
      {n:"Buckingham Palace",t:"Buckingham Palace"},
      {n:"St James's Park",t:"St James's Park"},
      {n:"Palacio de Westminster (Big Ben)",t:"Palace of Westminster"},
      {n:"Abadía de Westminster",t:"Westminster Abbey"},
      {n:"London Eye",t:"London Eye"},
      {n:"British Museum",t:"British Museum"},
      {n:"Covent Garden",t:"Covent Garden"},
      {n:"Leicester Square (LEGO Store)",t:"Leicester Square"},
      {n:"Chinatown",t:"Chinatown, London"},
      {n:"Soho",t:"Soho"},
      {n:"Piccadilly Circus",t:"Piccadilly Circus"},
      {n:"Harrods",t:"Harrods"},
      {n:"Camden Market",t:"Camden Market"},
      {n:"Camden Town",t:"Camden Town"},
      {n:"Torre de Londres",t:"Tower of London"},
      {n:"Tower Bridge",t:"Tower Bridge"},
      {n:"Borough Market",t:"Borough Market"},
      {n:"Río Támesis",t:"River Thames"}
    ];
    let wikiBuilt=false;
    function buildWiki(){
      if(wikiBuilt) return;
      const grid=document.getElementById("wikiGrid");
      grid.innerHTML=SITES.map(s=>`<a class="wiki-card" href="https://en.wikipedia.org/wiki/${encodeURIComponent(s.t.replace(/ /g,'_'))}" target="_blank" rel="noopener noreferrer">
        <figure class="photo"><img data-wikipedia="${s.t}" alt="${s.n}" loading="lazy"></figure>
        <span class="nombre">${s.n}</span></a>`).join("");
      wikiBuilt=true;
      hydrate(grid);
    }
    function openWiki(){ buildWiki(); openModal("modalWiki"); }

    /* ---------- Carga de fotos (Wikipedia + Commons) ---------- */
    async function fetchJSON(url){ const r=await fetch(url); if(!r.ok) throw new Error("net"); return r.json(); }
    async function wikiImg(title){ const d=await fetchJSON("https://en.wikipedia.org/api/rest_v1/page/summary/"+encodeURIComponent(title)); return d.thumbnail?.source||d.originalimage?.source||null; }
    async function commonsImg(q){ const url="https://commons.wikimedia.org/w/api.php?"+new URLSearchParams({action:"query",generator:"search",gsrsearch:q+" filetype:bitmap",gsrnamespace:"6",gsrlimit:"1",prop:"imageinfo",iiprop:"url",iiurlwidth:"1200",format:"json",origin:"*"}); const d=await fetchJSON(url); const p=d.query?.pages; if(!p) return null; const f=Object.values(p)[0]?.imageinfo?.[0]; return f?.thumburl||f?.url||null; }
    async function loadOne(img){
      const fig=img.closest(".photo"); const wt=img.dataset.wikipedia, cq=img.dataset.commons||wt;
      fig.classList.add("is-loading"); let src=null;
      if(wt){ try{ src=await wikiImg(wt);}catch(e){} }
      if(!src&&cq){ try{ src=await commonsImg(cq);}catch(e){} }
      if(!src&&wt){ try{ src=await commonsImg(wt);}catch(e){} }
      if(!src){ fig.classList.remove("is-loading"); fig.classList.add("is-error"); return; }
      img.referrerPolicy="no-referrer"; img.src=src;
      try{ await new Promise((res,rej)=>{img.onload=res;img.onerror=rej;}); fig.classList.remove("is-loading"); }
      catch(e){ fig.classList.remove("is-loading"); fig.classList.add("is-error"); }
    }
    function hydrate(scope){ scope.querySelectorAll(".photo img[data-wikipedia]:not([src]), .photo img[data-commons]:not([src])").forEach(img=>loadOne(img)); }
    hydrate(document);
  </script>
</body>
